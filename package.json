{
  "name": "@lorenzh/pulse-contract",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Shared TypeScript types (Check, Result, Incident and API shapes) used by all pulse repos.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-exclude='**/*.test.ts' --test-coverage-exclude='test/**' --test-coverage-exclude='**/test/**' --test-coverage-exclude='dist/**'",
    "lint": "biome check . && eslint --config tools/sonarjs/eslint.config.js .",
    "format": "biome check --write .",
    "prepare": "lefthook install || true",
    "check": "npm run lint && npm run build && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^26.6.5",
    "lefthook": "2.2.2",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "tools/sonarjs"
  ],
  "overrides": {
    "ts-api-utils": {
      "typescript": "6.0.3"
    }
  }
}
