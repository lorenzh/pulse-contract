{
  "name": "@lorenzh/pulse-contract",
  "version": "1.3.0",
  "license": "MIT",
  "description": "Shared TypeScript types, plain-TS runtime validators and the wire-format version used by all pulse repos.",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check . && pulse-eslint .",
    "format": "biome check --write .",
    "prepare": "lefthook install || true",
    "check": "bun run lint && bun run build && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@lorenzh/pulse-config": "github:lorenzh/pulse-config#51e95b0eb463b27a196a33b428607bd92443e4f0",
    "@types/node": "^26.6.5",
    "lefthook": "2.2.2",
    "typescript": "6.0.3",
    "@types/bun": "1.4.0"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
